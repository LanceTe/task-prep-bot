# Copy to .env and fill in real values. Never commit the real .env.

# Bot token from https://discord.com/developers/applications -> your app -> Bot
BOT_TOKEN=your-bot-token-here

# The channel for factory messages is chosen at runtime: run /setup-factories in the
# channel you want them posted to (no channel ID needed here).

# Members need a role with this name to run the admin commands. Defaults to "LT".
# ADMIN_ROLE_NAME=LT
